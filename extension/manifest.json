{
  "manifest_version": 3,
  "name": "Apollo Universal Lead Harvester",
  "version": "2.3.0",
  "description": "Authentic UI-driven Apollo Lead Extractor with Dual-Sort (A-Z + Z-A) capacity boost, in-page HUD, and instant 29-column CSV export",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://app.apollo.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.apollo.io/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "slicer_core.js",
        "hud.js",
        "hud.css"
      ],
      "matches": ["https://app.apollo.io/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apollo Universal Harvester"
  }
}
